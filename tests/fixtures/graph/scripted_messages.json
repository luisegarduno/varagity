    {"key": "plan", "guid": "fx-thread-plan", "display_name": "Cabin Trip", "participants": ["bob", "dave", "erin", "jane"]},
    {"key": "erin", "guid": "fx-thread-erin", "display_name": "", "participants": ["erin"]}
  ],
  "messages": [
    {"guid": "fx-hw-001", "thread": "hw", "from": "bob", "at": "2014-03-04T18:22:00Z", "text": "ok I finally caved. mechanical keyboard for the PC, blue switches"},
    {"guid": "fx-hw-002", "thread": "hw", "from": "me", "at": "2014-03-04T18:24:00Z", "text": "the loud clicky kind?"},
    {"guid": "fx-hw-003", "thread": "hw", "from": "bob", "at": "2014-03-04T18:25:00Z", "text": "it sounds like a typewriter and I love it. I am never going back"},
    {"guid": "fx-hw-004", "thread": "hw", "from": "dave", "at": "2014-03-04T18:27:00Z", "text": "you people are unwell"},
    {"guid": "fx-hw-005", "thread": "hw", "from": "bob", "at": "2014-03-04T18:31:00Z", "text": "typing on a mushy membrane board is like driving with the parking brake on", "tapbacks": [{"kind": "loved", "from": "me"}]},
    {"guid": "fx-hw-006", "thread": "hw", "from": "me", "at": "2014-03-04T18:40:00Z", "text": "how much was it"},
    {"guid": "fx-hw-007", "thread": "hw", "from": "bob", "at": "2014-03-04T18:41:00Z", "text": "don't ask"},
    {"guid": "fx-hw-008", "thread": "hw", "from": "dave", "at": "2014-09-12T13:02:00Z", "text": "I genuinely think computers made work worse. I get more done with a paper notebook"},
    {"guid": "fx-hw-009", "thread": "hw", "from": "bob", "at": "2014-09-12T13:05:00Z", "text": "you type with two fingers dave"},
    {"guid": "fx-hw-010", "thread": "hw", "from": "dave", "at": "2014-09-12T13:06:00Z", "text": "and yet"},
    {"guid": "fx-hw-011", "thread": "hw", "from": "me", "at": "2014-09-12T13:15:00Z", "text": "he has a point about the notebook"},
    {"guid": "fx-hw-012", "thread": "hw", "from": "me", "at": "2015-11-20T21:03:00Z", "text": "new work laptop today. the trackpad is enormous"},
    {"guid": "fx-hw-013", "thread": "hw", "from": "bob", "at": "2015-11-20T21:07:00Z", "text": "every laptop trackpad is a compromise. I keep a mouse in my bag for exactly this reason"},
    {"guid": "fx-hw-014", "thread": "hw", "from": "dave", "at": "2015-11-20T21:09:00Z", "text": "or a pen"},
    {"guid": "fx-hw-015", "thread": "hw", "from": "bob", "at": "2016-06-08T19:44:00Z", "text": "building my own tower again this summer. prebuilts always cheap out on the power supply"},
    {"guid": "fx-hw-016", "thread": "hw", "from": "me", "at": "2016-06-08T19:46:00Z", "text": "what parts"},
    {"guid": "fx-hw-017", "thread": "hw", "from": "bob", "at": "2016-06-08T19:52:00Z", "text": "36 tabs of parts lists open right now, ask me tomorrow"},
    {"guid": "fx-hw-018", "thread": "hw", "from": "erin", "at": "2016-06-08T20:01:00Z", "text": "please send pictures when it's done"},
    {"guid": "fx-hw-019", "thread": "hw", "from": "bob", "at": "2018-05-30T12:11:00Z", "text": "mark my words, everything ends up on ARM chips eventually. phones proved it works"},
    {"guid": "fx-hw-020", "thread": "hw", "from": "dave", "at": "2018-05-30T12:14:00Z", "text": "everything ends up in a landfill eventually"},
    {"guid": "fx-hw-021", "thread": "hw", "from": "erin", "at": "2018-05-30T12:20:00Z", "text": "dave you are a ray of sunshine"},
    {"guid": "fx-hw-022", "thread": "hw", "from": "me", "at": "2018-05-30T12:31:00Z", "text": "ARM as in the phone processors?"},
    {"guid": "fx-hw-023", "thread": "hw", "from": "bob", "at": "2018-05-30T12:33:00Z", "text": "same family yeah. laptops next, then desktops. x86 is carrying forty years of baggage"},
    {"guid": "fx-hw-024", "thread": "hw", "from": "dave", "at": "2019-03-19T08:50:00Z", "text": "deleted the last two apps off my phone. it's a phone again"},
    {"guid": "fx-hw-025", "thread": "hw", "from": "erin", "at": "2019-03-19T08:55:00Z", "text": "what do you do at the dmv now"},
    {"guid": "fx-hw-026", "thread": "hw", "from": "dave", "at": "2019-03-19T08:57:00Z", "text": "I bring a book"},
    {"guid": "fx-hw-027", "thread": "hw", "from": "bob", "at": "2020-11-11T09:15:00Z", "text": "told you. the new apple laptops are ARM and they are absurdly fast"},
    {"guid": "fx-hw-028", "thread": "hw", "from": "me", "at": "2020-11-11T09:22:00Z", "text": "you did in fact tell us"},
    {"guid": "fx-hw-029", "thread": "hw", "from": "dave", "at": "2020-11-11T09:40:00Z", "text": "my 2011 laptop still turns on. that is all I have ever needed from a computer"},
    {"guid": "fx-hw-030", "thread": "hw", "from": "erin", "at": "2020-11-11T09:41:00Z", "text": "it takes four minutes to open a browser"},
    {"guid": "fx-hw-031", "thread": "hw", "from": "dave", "at": "2020-11-11T09:45:00Z", "text": "four minutes to think"},
    {"guid": "fx-hw-032", "thread": "hw", "from": "erin", "at": "2021-05-27T18:10:00Z", "text": "graphics cards cost more than my first car"},
    {"guid": "fx-hw-033", "thread": "hw", "from": "bob", "at": "2021-05-27T18:14:00Z", "text": "I'm sitting this generation out. the whole market is a joke right now"},
    {"guid": "fx-hw-034", "thread": "hw", "from": "me", "at": "2021-05-27T18:20:00Z", "text": "sitting it out how long"},
    {"guid": "fx-hw-035", "thread": "hw", "from": "bob", "at": "2021-05-27T18:22:00Z", "text": "until prices are legal again"},
    {"guid": "fx-hw-036", "thread": "hw", "from": "bob", "at": "2022-07-14T20:02:00Z", "text": "put linux on the old thinkpad and it's a completely different machine. eight year old hardware, feels new"},
    {"guid": "fx-hw-037", "thread": "hw", "from": "erin", "at": "2022-07-14T20:10:00Z", "text": "is that the one with the stickers"},
    {"guid": "fx-hw-038", "thread": "hw", "from": "bob", "at": "2022-07-14T20:12:00Z", "text": "the very one"},
    {"guid": "fx-hw-039", "thread": "hw", "from": "erin", "at": "2023-01-08T16:47:00Z", "text": "got a mechanical keyboard for christmas and I finally understand the hype"},
    {"guid": "fx-hw-040", "thread": "hw", "from": "bob", "at": "2023-01-08T16:49:00Z", "text": "welcome to the club"},
    {"guid": "fx-hw-041", "thread": "hw", "from": "me", "at": "2023-01-08T16:55:00Z", "text": "bob has been waiting nine years for this moment"},
    {"guid": "fx-hw-042", "thread": "hw", "from": "bob", "at": "2024-04-02T11:20:00Z", "text": "third keyboard this year. tactile browns, and I think this one is the endgame"},
    {"guid": "fx-hw-043", "thread": "hw", "from": "dave", "at": "2024-04-02T11:25:00Z", "text": "the endgame is a pencil"},
    {"guid": "fx-hw-044", "thread": "hw", "from": "erin", "at": "2024-04-02T11:30:00Z", "text": "let him have this"},

    {"guid": "fx-bob-001", "thread": "bob", "from": "bob", "at": "2015-04-17T08:12:00Z", "text": "borrowed a laptop at work today and remembered exactly why I hate trackpads"},
    {"guid": "fx-bob-002", "thread": "bob", "from": "me", "at": "2015-04-17T08:14:00Z", "text": "what's wrong with them"},
    {"guid": "fx-bob-003", "thread": "bob", "from": "bob", "at": "2015-04-17T08:16:00Z", "text": "palm rejection is a lie. I dropped my cursor into another paragraph twice writing one email"},
    {"guid": "fx-bob-004", "thread": "bob", "from": "me", "at": "2015-04-17T08:20:00Z", "text": "so, a mouse"},
    {"guid": "fx-bob-005", "thread": "bob", "from": "bob", "at": "2015-04-17T08:21:00Z", "text": "always a mouse", "tapbacks": [{"kind": "liked", "from": "me", "whole": true}]},
    {"guid": "fx-bob-006", "thread": "bob", "from": "bob", "at": "2016-03-13T19:00:00Z", "text": "doing nothing for my birthday again this year, just so you know"},
    {"guid": "fx-bob-007", "thread": "bob", "from": "me", "at": "2016-03-13T19:03:00Z", "text": "that's what you said last year"},
    {"guid": "fx-bob-008", "thread": "bob", "from": "bob", "at": "2016-03-13T19:05:00Z", "text": "and I meant it last year too"},
    {"guid": "fx-bob-009", "thread": "bob", "from": "bob", "at": "2018-02-02T21:31:00Z", "text": "put an SSD in my mom's old desktop and she thinks I performed surgery on it"},
    {"guid": "fx-bob-010", "thread": "bob", "from": "me", "at": "2018-02-02T21:35:00Z", "text": "you kind of did"},
    {"guid": "fx-bob-011", "thread": "bob", "from": "bob", "at": "2019-10-05T15:12:00Z", "text": "16gb of ram is the floor now. the browser eats it for breakfast"},
    {"guid": "fx-bob-012", "thread": "bob", "from": "me", "at": "2019-10-05T15:14:00Z", "text": "close some tabs"},
    {"guid": "fx-bob-013", "thread": "bob", "from": "bob", "at": "2019-10-05T15:15:00Z", "text": "never"},
    {"guid": "fx-bob-014", "thread": "bob", "from": "bob", "at": "2020-09-08T12:40:00Z", "text": "spent the weekend rewiring the office. cable management is a personality trait apparently"},
    {"guid": "fx-bob-015", "thread": "bob", "from": "me", "at": "2020-09-08T12:44:00Z", "text": "pictures or it didn't happen"},
    {"guid": "fx-bob-016", "thread": "bob", "from": "bob", "at": "2021-06-19T13:40:00Z", "text": "new laptop. the trackpad is less bad than it used to be, but I still plug the mouse in the second I sit down"},
    {"guid": "fx-bob-017", "thread": "bob", "from": "me", "at": "2021-06-19T13:44:00Z", "text": "is that the ARM one"},
    {"guid": "fx-bob-018", "thread": "bob", "from": "bob", "at": "2021-06-19T13:45:00Z", "text": "apple silicon yeah. all day battery, the fans never come on, it's the future and I said so first"},
    {"guid": "fx-bob-019", "thread": "bob", "from": "me", "at": "2023-03-14T09:02:00Z", "text": "happy birthday!!"},
    {"guid": "fx-bob-020", "thread": "bob", "from": "bob", "at": "2023-03-14T09:30:00Z", "text": "thank you. carol already made me answer the door in a party hat"},
    {"guid": "fx-bob-021", "thread": "bob", "from": "bob", "at": "2024-08-09T18:03:00Z", "text": "I'm telling you, in five years nobody is buying an x86 laptop"},
    {"guid": "fx-bob-022", "thread": "bob", "from": "me", "at": "2024-08-09T18:05:00Z", "text": "you have said this before"},
    {"guid": "fx-bob-023", "thread": "bob", "from": "bob", "at": "2024-08-09T18:06:00Z", "text": "and I will say it again"},

    {"guid": "fx-jane-001", "thread": "jane", "from": "jane", "at": "2019-04-02T11:03:00Z", "text": "this laptop keyboard is awful, half the letters stick"},
    {"guid": "fx-jane-002", "thread": "jane", "from": "me", "at": "2019-04-02T11:05:00Z", "text": "time for a new laptop"},
    {"guid": "fx-jane-003", "thread": "jane", "from": "jane", "at": "2019-04-02T11:07:00Z", "text": "time for a lottery ticket"},
    {"guid": "fx-jane-004", "thread": "jane", "from": "jane", "at": "2020-12-27T14:20:00Z", "text": "the recital got moved online again"},
    {"guid": "fx-jane-005", "thread": "jane", "from": "me", "at": "2020-12-27T14:25:00Z", "text": "that's rough. still playing the chopin?"},
    {"guid": "fx-jane-006", "thread": "jane", "from": "jane", "at": "2020-12-27T14:30:00Z", "text": "yes, but for a webcam instead of people"},
    {"guid": "fx-jane-007", "thread": "jane", "from": "jane", "at": "2021-09-18T10:02:00Z", "text": "at the computer store with my brother, he's buying a monitor"},
    {"guid": "fx-jane-008", "thread": "jane", "from": "me", "at": "2021-09-18T10:05:00Z", "text": "dangerous place to be"},
    {"guid": "fx-jane-009", "thread": "jane", "from": "jane", "at": "2021-09-18T10:11:00Z", "text": "they have a whole wall of keyboards you can type on"},
    {"guid": "fx-jane-010", "thread": "jane", "from": "jane", "at": "2021-09-18T10:12:00Z", "text": "ok I get it now. I like mechanical keyboards. the clicky ones are ridiculous and I want one"},
    {"guid": "fx-jane-011", "thread": "jane", "from": "me", "at": "2021-09-18T10:14:00Z", "text": "oh no. don't tell bob"},
    {"guid": "fx-jane-012", "thread": "jane", "from": "jane", "at": "2021-09-18T10:15:00Z", "text": "too late, I already texted him", "tapbacks": [{"kind": "laughed", "from": "me"}]},
    {"guid": "fx-jane-013", "thread": "jane", "from": "jane", "at": "2021-09-18T10:40:00Z", "text": "bought one. brown switches, whatever that means"},
    {"guid": "fx-jane-014", "thread": "jane", "from": "me", "at": "2021-09-18T10:41:00Z", "text": "congratulations, you're one of them now"},
    {"guid": "fx-jane-015", "thread": "jane", "from": "jane", "at": "2021-09-18T18:22:00Z", "text": "typed on it all afternoon. no regrets"},
    {"guid": "fx-jane-016", "thread": "jane", "from": "jane", "at": "2022-05-08T16:11:00Z", "text": "started teaching a beginner student on saturday mornings"},
    {"guid": "fx-jane-017", "thread": "jane", "from": "me", "at": "2022-05-08T16:14:00Z", "text": "how old"},
    {"guid": "fx-jane-018", "thread": "jane", "from": "jane", "at": "2022-05-08T16:15:00Z", "text": "seven, and she has more patience than I do"},
    {"guid": "fx-jane-019", "thread": "jane", "from": "jane", "at": "2023-06-24T20:02:00Z", "text": "sight read at a funeral today. two hymns I had never seen before"},
    {"guid": "fx-jane-020", "thread": "jane", "from": "me", "at": "2023-06-24T20:10:00Z", "text": "how did it go"},
    {"guid": "fx-jane-021", "thread": "jane", "from": "jane", "at": "2023-06-24T20:12:00Z", "text": "nobody threw anything"},
    {"guid": "fx-jane-022", "thread": "jane", "from": "jane", "at": "2024-02-11T20:30:00Z", "text": "ms petrov says I'm finally playing the left hand like I mean it"},
    {"guid": "fx-jane-023", "thread": "jane", "from": "me", "at": "2024-02-11T20:33:00Z", "text": "twelve years of lessons"},
    {"guid": "fx-jane-024", "thread": "jane", "from": "jane", "at": "2024-02-11T20:35:00Z", "text": "she will never let me graduate"},

    {"guid": "fx-music-001", "thread": "music", "from": "jane", "at": "2018-09-09T17:02:00Z", "text": "new keyboard arrived. 88 weighted keys, it finally feels like a real piano under my hands"},
    {"guid": "fx-music-002", "thread": "music", "from": "erin", "at": "2018-09-09T17:04:00Z", "text": "does it have the fake harpsichord"},
    {"guid": "fx-music-003", "thread": "music", "from": "jane", "at": "2018-09-09T17:05:00Z", "text": "it has 200 fake sounds and I dislike all of them"},
    {"guid": "fx-music-004", "thread": "music", "from": "me", "at": "2018-09-09T17:10:00Z", "text": "play the harpsichord at the recital"},
    {"guid": "fx-music-005", "thread": "music", "from": "jane", "at": "2019-01-22T19:41:00Z", "text": "ms petrov assigned me the debussy. I'll be sight reading it until I'm forty"},
    {"guid": "fx-music-006", "thread": "music", "from": "erin", "at": "2019-01-22T19:44:00Z", "text": "is she the one who taught you as a kid?"},
    {"guid": "fx-music-007", "thread": "music", "from": "jane", "at": "2019-01-22T19:46:00Z", "text": "same piano teacher since I was nine. ms petrov has heard every mistake I own"},
    {"guid": "fx-music-008", "thread": "music", "from": "erin", "at": "2020-08-15T12:00:00Z", "text": "practicing anything or is it a lazy summer"},
    {"guid": "fx-music-009", "thread": "music", "from": "jane", "at": "2020-08-15T12:20:00Z", "text": "scales, endless scales. the keyboard action is heavier than the school piano so my hands are wrecked"},
    {"guid": "fx-music-010", "thread": "music", "from": "me", "at": "2020-08-15T12:22:00Z", "text": "sounds like a good problem"},
    {"guid": "fx-music-011", "thread": "music", "from": "jane", "at": "2022-11-03T21:15:00Z", "text": "played the church organ on sunday. three keyboards and a pedalboard, absolutely terrifying"},
    {"guid": "fx-music-012", "thread": "music", "from": "erin", "at": "2022-11-03T21:18:00Z", "text": "did you make it out alive"},
    {"guid": "fx-music-013", "thread": "music", "from": "jane", "at": "2022-11-03T21:20:00Z", "text": "barely. organists are a different species"},
    {"guid": "fx-music-014", "thread": "music", "from": "erin", "at": "2023-11-19T15:40:00Z", "text": "recital tickets?"},
    {"guid": "fx-music-015", "thread": "music", "from": "jane", "at": "2023-11-19T15:44:00Z", "text": "the door is free, the program is two dollars, I'm on eighth"},
    {"guid": "fx-music-016", "thread": "music", "from": "me", "at": "2023-11-19T15:50:00Z", "text": "front row then"},

    {"guid": "fx-carol-001", "thread": "carol", "from": "carol", "at": "2017-03-13T08:40:00Z", "text": "heads up, it's Bob's birthday tomorrow, march 14th. he will pretend he doesn't care"},
    {"guid": "fx-carol-002", "thread": "carol", "from": "me", "at": "2017-03-13T08:42:00Z", "text": "thank you for the warning"},
    {"guid": "fx-carol-003", "thread": "carol", "from": "me", "at": "2017-03-13T08:43:00Z", "text": "he told me last year that he doesn't do birthdays"},
    {"guid": "fx-carol-004", "thread": "carol", "from": "carol", "at": "2017-03-13T08:45:00Z", "text": "he says that every year and then sulks if nobody texts him"},
    {"guid": "fx-carol-005", "thread": "carol", "from": "me", "at": "2017-03-13T08:47:00Z", "text": "cake or no cake"},
    {"guid": "fx-carol-006", "thread": "carol", "from": "carol", "at": "2017-03-13T08:50:00Z", "text": "cake, chocolate, and not a surprise party. he would never forgive us", "tapbacks": [{"kind": "liked", "from": "me"}]},
    {"guid": "fx-carol-007", "thread": "carol", "from": "carol", "at": "2018-06-04T13:12:00Z", "text": "are you around saturday? we're helping dave move"},
    {"guid": "fx-carol-008", "thread": "carol", "from": "me", "at": "2018-06-04T13:30:00Z", "text": "saturday works"},
    {"guid": "fx-carol-009", "thread": "carol", "from": "carol", "at": "2018-06-04T13:32:00Z", "text": "he has forty boxes of books. bring gloves"},
    {"guid": "fx-carol-010", "thread": "carol", "from": "carol", "at": "2019-09-11T18:00:00Z", "text": "did you ever finish the book I lent you"},
    {"guid": "fx-carol-011", "thread": "carol", "from": "me", "at": "2019-09-11T18:20:00Z", "text": "it's on my nightstand judging me"},
    {"guid": "fx-carol-012", "thread": "carol", "from": "carol", "at": "2019-09-11T18:22:00Z", "text": "as it should"},
    {"guid": "fx-carol-013", "thread": "carol", "from": "carol", "at": "2022-04-19T07:50:00Z", "text": "I got the job at the bakery!! I start monday"},
    {"guid": "fx-carol-014", "thread": "carol", "from": "me", "at": "2022-04-19T07:52:00Z", "text": "CAROL. congratulations", "tapbacks": [{"kind": "loved", "from": "carol"}]},
    {"guid": "fx-carol-015", "thread": "carol", "from": "carol", "at": "2022-04-19T07:55:00Z", "text": "4am shifts. pray for me"},
    {"guid": "fx-carol-016", "thread": "carol", "from": "me", "at": "2022-04-19T08:10:00Z", "text": "free bread though"},
    {"guid": "fx-carol-017", "thread": "carol", "from": "carol", "at": "2022-04-19T08:11:00Z", "text": "free bread though"},
    {"guid": "fx-carol-018", "thread": "carol", "from": "carol", "at": "2023-03-14T07:30:00Z", "text": "it's the 14th. you know what that means"},
    {"guid": "fx-carol-019", "thread": "carol", "from": "me", "at": "2023-03-14T07:35:00Z", "text": "already texted him"},
    {"guid": "fx-carol-020", "thread": "carol", "from": "carol", "at": "2023-03-14T07:36:00Z", "text": "gold star"},

    {"guid": "fx-dave-001", "thread": "dave", "from": "dave", "at": "2016-02-08T10:04:00Z", "text": "bought a fountain pen. best productivity upgrade in years"},
    {"guid": "fx-dave-002", "thread": "dave", "from": "me", "at": "2016-02-08T10:20:00Z", "text": "of course you did"},
    {"guid": "fx-dave-003", "thread": "dave", "from": "dave", "at": "2017-11-14T22:10:00Z", "text": "deleted every app that sends notifications. phones are attention slot machines"},
    {"guid": "fx-dave-004", "thread": "dave", "from": "me", "at": "2017-11-14T22:14:00Z", "text": "including messages?"},
    {"guid": "fx-dave-005", "thread": "dave", "from": "dave", "at": "2017-11-14T22:15:00Z", "text": "obviously not, I'm texting you"},
    {"guid": "fx-dave-006", "thread": "dave", "from": "dave", "at": "2018-07-21T16:02:00Z", "text": "I can't make the cabin this year, my sister's wedding is that same weekend"},
    {"guid": "fx-dave-007", "thread": "dave", "from": "me", "at": "2018-07-21T16:10:00Z", "text": "we'll drink your share of the chili"},
    {"guid": "fx-dave-008", "thread": "dave", "from": "dave", "at": "2018-07-21T16:11:00Z", "text": "that is not how chili works"},
    {"guid": "fx-dave-009", "thread": "dave", "from": "me", "at": "2019-08-02T09:00:00Z", "text": "happy birthday dave"},
    {"guid": "fx-dave-010", "thread": "dave", "from": "dave", "at": "2019-08-02T09:40:00Z", "text": "thanks. august 2nd, same as every year"},
    {"guid": "fx-dave-011", "thread": "dave", "from": "dave", "at": "2019-08-02T09:41:00Z", "text": "no party. do not organize a party"},
    {"guid": "fx-dave-012", "thread": "dave", "from": "dave", "at": "2021-03-30T14:22:00Z", "text": "still on the 2011 laptop. it does email and it does taxes"},
    {"guid": "fx-dave-013", "thread": "dave", "from": "me", "at": "2021-03-30T14:25:00Z", "text": "how is it still alive"},
    {"guid": "fx-dave-014", "thread": "dave", "from": "dave", "at": "2021-03-30T14:26:00Z", "text": "I never installed anything on it"},
    {"guid": "fx-dave-015", "thread": "dave", "from": "dave", "at": "2023-10-17T19:50:00Z", "text": "wrote the whole talk on paper first. typing makes me edit while I think and then I never finish a sentence"},
    {"guid": "fx-dave-016", "thread": "dave", "from": "me", "at": "2023-10-17T19:55:00Z", "text": "that's actually a good argument"},
    {"guid": "fx-dave-017", "thread": "dave", "from": "dave", "at": "2023-10-17T19:57:00Z", "text": "I have several"},

    {"guid": "fx-crew-001", "thread": "crew", "from": "bob", "at": "2016-01-16T17:20:00Z", "text": "adding Erin to the thread. she rebuilt my alternator in a parking lot with a wrench and pure contempt"},
    {"guid": "fx-crew-002", "thread": "crew", "from": "carol", "at": "2016-01-16T17:22:00Z", "text": "welcome erin"},
    {"guid": "fx-crew-003", "thread": "crew", "from": "me", "at": "2016-01-16T17:23:00Z", "text": "welcome!"},
    {"guid": "fx-crew-004", "thread": "crew", "from": "erin", "at": "2016-01-16T17:40:00Z", "text": "hi everyone. bob is exaggerating, it was a starter motor"},
    {"guid": "fx-crew-005", "thread": "crew", "from": "jane", "at": "2017-05-06T12:02:00Z", "text": "recital saturday, if anyone wants two hours of children and then eleven minutes of me"},
    {"guid": "fx-crew-006", "thread": "crew", "from": "carol", "at": "2017-05-06T12:05:00Z", "text": "I'm coming for the eleven minutes"},
    {"guid": "fx-crew-007", "thread": "crew", "from": "me", "at": "2017-05-06T12:09:00Z", "text": "wouldn't miss it"},
    {"guid": "fx-crew-008", "thread": "crew", "from": "bob", "at": "2019-02-24T15:33:00Z", "text": "ARM laptops are two years out and everyone is going to act surprised"},
    {"guid": "fx-crew-009", "thread": "crew", "from": "jane", "at": "2019-02-24T15:35:00Z", "text": "what is ARM"},
    {"guid": "fx-crew-010", "thread": "crew", "from": "bob", "at": "2019-02-24T15:36:00Z", "text": "the chip in your phone. it sips power, x86 drinks"},
    {"guid": "fx-crew-011", "thread": "crew", "from": "carol", "at": "2019-02-24T15:38:00Z", "text": "beautiful. anyway, brunch sunday?"},
    {"guid": "fx-crew-012", "thread": "crew", "from": "me", "at": "2019-02-24T15:40:00Z", "text": "brunch sunday"},
    {"guid": "fx-crew-013", "thread": "crew", "from": "erin", "at": "2020-05-02T11:11:00Z", "text": "did anyone else's sourdough starter die"},
    {"guid": "fx-crew-014", "thread": "crew", "from": "carol", "at": "2020-05-02T11:14:00Z", "text": "mine is thriving and I am insufferable about it"},
    {"guid": "fx-crew-015", "thread": "crew", "from": "bob", "at": "2020-05-02T11:20:00Z", "text": "mine lives in the fridge in suspended animation"},
    {"guid": "fx-crew-016", "thread": "crew", "from": "carol", "at": "2021-12-24T20:00:00Z", "text": "merry christmas eve you beautiful people"},
    {"guid": "fx-crew-017", "thread": "crew", "from": "jane", "at": "2021-12-24T20:02:00Z", "text": "🎄"},
    {"guid": "fx-crew-018", "thread": "crew", "from": "me", "at": "2021-12-24T20:05:00Z", "text": "🎄🎄"},
    {"guid": "fx-crew-019", "thread": "crew", "from": "bob", "at": "2021-12-24T20:30:00Z", "text": "🎄 and I bought myself a keyboard again, linear reds this time"},
    {"guid": "fx-crew-020", "thread": "crew", "from": "jane", "at": "2023-09-30T13:45:00Z", "text": "played a wedding today. they asked for pachelbel, I played pachelbel"},
    {"guid": "fx-crew-021", "thread": "crew", "from": "erin", "at": "2023-09-30T13:50:00Z", "text": "a professional"},
    {"guid": "fx-crew-022", "thread": "crew", "from": "bob", "at": "2023-09-30T13:52:00Z", "text": "what does a wedding pay"},
    {"guid": "fx-crew-023", "thread": "crew", "from": "jane", "at": "2023-09-30T13:55:00Z", "text": "enough for a keyboard, apparently", "tapbacks": [{"kind": "laughed", "from": "bob"}]},

    {"guid": "fx-cook-001", "thread": "cook", "from": "bob", "at": "2018-01-14T18:30:00Z", "text": "spent six hours on a ramen broth today. six hours"},
    {"guid": "fx-cook-002", "thread": "cook", "from": "carol", "at": "2018-01-14T18:33:00Z", "text": "was it worth it"},
    {"guid": "fx-cook-003", "thread": "cook", "from": "bob", "at": "2018-01-14T18:35:00Z", "text": "ask me when I have slept"},
    {"guid": "fx-cook-004", "thread": "cook", "from": "me", "at": "2018-01-14T18:40:00Z", "text": "was it worth it though"},
    {"guid": "fx-cook-005", "thread": "cook", "from": "bob", "at": "2018-01-14T18:41:00Z", "text": "yes"},
    {"guid": "fx-cook-006", "thread": "cook", "from": "carol", "at": "2019-11-28T10:15:00Z", "text": "thanksgiving assignments. bob you have the bird"},
    {"guid": "fx-cook-007", "thread": "cook", "from": "bob", "at": "2019-11-28T10:20:00Z", "text": "I'll brine it wednesday night"},
    {"guid": "fx-cook-008", "thread": "cook", "from": "me", "at": "2019-11-28T10:22:00Z", "text": "I'll bring pie and the folding chairs"},
    {"guid": "fx-cook-009", "thread": "cook", "from": "bob", "at": "2020-04-18T09:40:00Z", "text": "sourdough day twelve. the loaf finally has holes in it"},
    {"guid": "fx-cook-010", "thread": "cook", "from": "carol", "at": "2020-04-18T09:45:00Z", "text": "photograph the crumb immediately"},
    {"guid": "fx-cook-011", "thread": "cook", "from": "bob", "at": "2020-04-18T09:50:00Z", "text": "it looks like a sponge and I have never been prouder", "tapbacks": [{"kind": "loved", "from": "carol"}]},
    {"guid": "fx-cook-012", "thread": "cook", "from": "bob", "at": "2021-10-09T17:05:00Z", "text": "made a curry from scratch, ground the spices myself. the kitchen smells incredible"},
    {"guid": "fx-cook-013", "thread": "cook", "from": "carol", "at": "2021-10-09T17:10:00Z", "text": "recipe please"},
    {"guid": "fx-cook-014", "thread": "cook", "from": "bob", "at": "2021-10-09T17:30:00Z", "text": "it's four pages long, I'll bring it saturday"},
    {"guid": "fx-cook-015", "thread": "cook", "from": "carol", "at": "2023-06-11T12:12:00Z", "text": "the bakery is teaching me laminated dough and my arms hurt"},
    {"guid": "fx-cook-016", "thread": "cook", "from": "bob", "at": "2023-06-11T12:15:00Z", "text": "croissants?"},
    {"guid": "fx-cook-017", "thread": "cook", "from": "carol", "at": "2023-06-11T12:16:00Z", "text": "croissants"},
    {"guid": "fx-cook-018", "thread": "cook", "from": "me", "at": "2023-06-11T12:20:00Z", "text": "we will accept all failed experiments"},

    {"guid": "fx-plan-001", "thread": "plan", "from": "erin", "at": "2016-07-02T08:15:00Z", "text": "my aunt marisol says the cabin is ours the last week of july"},
    {"guid": "fx-plan-002", "thread": "plan", "from": "bob", "at": "2016-07-02T08:20:00Z", "text": "firewood run on the way up, I'll take the truck"},
    {"guid": "fx-plan-003", "thread": "plan", "from": "dave", "at": "2016-07-02T08:22:00Z", "text": "I'm making the chili"},
    {"guid": "fx-plan-004", "thread": "plan", "from": "me", "at": "2016-07-02T08:25:00Z", "text": "board games and the big cooler are in my garage"},
    {"guid": "fx-plan-005", "thread": "plan", "from": "jane", "at": "2016-07-02T08:30:00Z", "text": "I'll bring the guitar since there's no piano up there"},
    {"guid": "fx-plan-006", "thread": "plan", "from": "erin", "at": "2016-07-30T21:40:00Z", "text": "the roof is leaking over the back bedroom again. buckets tonight"},
    {"guid": "fx-plan-007", "thread": "plan", "from": "bob", "at": "2016-07-30T21:44:00Z", "text": "we'll tarp it in the morning"},
    {"guid": "fx-plan-008", "thread": "plan", "from": "dave", "at": "2016-07-30T21:50:00Z", "text": "the chili was unaffected"},
    {"guid": "fx-plan-009", "thread": "plan", "from": "erin", "at": "2017-07-15T09:02:00Z", "text": "same week as last year, marisol confirmed"},
    {"guid": "fx-plan-010", "thread": "plan", "from": "bob", "at": "2017-07-15T09:10:00Z", "text": "firewood, cooler, done"},
    {"guid": "fx-plan-011", "thread": "plan", "from": "jane", "at": "2017-07-15T09:15:00Z", "text": "I can't do the whole week, driving up on thursday"},
    {"guid": "fx-plan-012", "thread": "plan", "from": "erin", "at": "2018-07-19T20:00:00Z", "text": "headcount for the cabin? I need to know how many mattresses to drag out"},
    {"guid": "fx-plan-013", "thread": "plan", "from": "bob", "at": "2018-07-19T20:05:00Z", "text": "five if dave comes"},
    {"guid": "fx-plan-014", "thread": "plan", "from": "dave", "at": "2018-07-19T20:20:00Z", "text": "four. wedding that weekend, I already said so"},
    {"guid": "fx-plan-015", "thread": "plan", "from": "me", "at": "2018-07-19T20:25:00Z", "text": "four confirmed"},
    {"guid": "fx-plan-016", "thread": "plan", "from": "erin", "at": "2019-08-24T14:00:00Z", "text": "the roof is fixed!! marisol had it reshingled in june. no buckets this year"},
    {"guid": "fx-plan-017", "thread": "plan", "from": "dave", "at": "2019-08-24T14:05:00Z", "text": "a moment of silence for the buckets"},
    {"guid": "fx-plan-018", "thread": "plan", "from": "bob", "at": "2019-08-24T14:10:00Z", "text": "does the chili taste different without the drip"},
    {"guid": "fx-plan-019", "thread": "plan", "from": "dave", "at": "2019-08-24T14:12:00Z", "text": "the chili is a constant"},
    {"guid": "fx-plan-020", "thread": "plan", "from": "erin", "at": "2020-06-11T19:00:00Z", "text": "no cabin this summer, marisol is keeping it closed"},
    {"guid": "fx-plan-021", "thread": "plan", "from": "jane", "at": "2020-06-11T19:05:00Z", "text": "next year then"},
    {"guid": "fx-plan-022", "thread": "plan", "from": "dave", "at": "2020-06-11T19:07:00Z", "text": "I'll make the chili at home out of spite"},
    {"guid": "fx-plan-023", "thread": "plan", "from": "erin", "at": "2021-07-24T07:45:00Z", "text": "cabin week is on. the firewood is stacked already, marisol has been busy"},
    {"guid": "fx-plan-024", "thread": "plan", "from": "jane", "at": "2021-07-24T07:50:00Z", "text": "bringing the keyboard this time, there's finally an outlet in the front room"},
    {"guid": "fx-plan-025", "thread": "plan", "from": "me", "at": "2021-07-24T07:55:00Z", "text": "chili? dave?"},
    {"guid": "fx-plan-026", "thread": "plan", "from": "dave", "at": "2021-07-24T08:02:00Z", "text": "the chili is not optional"},
    {"guid": "fx-plan-027", "thread": "plan", "from": "erin", "at": "2023-07-28T19:30:00Z", "text": "final cabin list. firewood, chili, board games, and whatever bob is fermenting"},
    {"guid": "fx-plan-028", "thread": "plan", "from": "bob", "at": "2023-07-28T19:35:00Z", "text": "it's kimchi and it's fine"},
    {"guid": "fx-plan-029", "thread": "plan", "from": "jane", "at": "2023-07-28T19:40:00Z", "text": "I'll be there friday"},
    {"guid": "fx-plan-030", "thread": "plan", "from": "me", "at": "2023-07-28T19:45:00Z", "text": "cooler is already in the truck"},

    {"guid": "fx-erin-001", "thread": "erin", "from": "erin", "at": "2019-06-12T15:10:00Z", "text": "your car sounds like a bag of forks. bring it by on saturday"},
    {"guid": "fx-erin-002", "thread": "erin", "from": "me", "at": "2019-06-12T15:12:00Z", "text": "how bad is it"},
    {"guid": "fx-erin-003", "thread": "erin", "from": "erin", "at": "2019-06-12T15:14:00Z", "text": "bring it by on saturday"},
    {"guid": "fx-erin-004", "thread": "erin", "from": "erin", "at": "2022-02-11T17:02:00Z", "text": "You gonna be home tonight", "attributed": true},
    {"guid": "fx-erin-005", "thread": "erin", "from": "me", "at": "2022-02-11T17:20:00Z", "text": "after seven, why"},
    {"guid": "fx-erin-006", "thread": "erin", "from": "erin", "at": "2022-02-11T17:22:00Z", "text": "I still have your ladder and my trunk is full"},
    {"guid": "fx-erin-007", "thread": "erin", "from": "erin", "at": "2023-08-05T10:15:00Z", "text": "brake pads. saturday. don't argue"},
    {"guid": "fx-erin-008", "thread": "erin", "from": "me", "at": "2023-08-05T10:30:00Z", "text": "I wasn't going to"},
    {"guid": "fx-erin-009", "thread": "erin", "from": "erin", "at": "2024-05-30T16:44:00Z", "text": "You gonna be home tonight", "attributed": true},
    {"guid": "fx-erin-010", "thread": "erin", "from": "me", "at": "2024-05-30T16:50:00Z", "text": "yes. ladder again?"},
    {"guid": "fx-erin-011", "thread": "erin", "from": "erin", "at": "2024-05-30T16:51:00Z", "text": "pressure washer this time"}
  ]
}
